# PostgreSQL (SQLAlchemy + psycopg)
DATABASE_URL=postgresql+psycopg://bhoomiscan:bhoomiscan@localhost:5432/bhoomiscan

# JWT — generate a long random secret for production
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Uploads
MAX_FILE_SIZE_MB=10

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sarvam Document AI (Phase 2). Never commit a real key.
SARVAM_API_KEY=

# Promote an existing username to SUPER_ADMIN on API startup (optional).
BOOTSTRAP_SUPER_ADMIN_USERNAME=
